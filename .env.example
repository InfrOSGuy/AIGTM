# Copy to .env and fill in real values. Never commit .env — it's
# git-ignored, and CI runs a secret scan on every push regardless.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://aigtm:aigtm@localhost:5432/aigtm

# AES-256-GCM key for encrypting stored OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Pre-shared secret you exchange once at /auth/login for a session
# cookie. Treat like a password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# (Web application). Add ${APP_BASE_URL}/auth/gmail/callback as an
# authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# HubSpot integration is temporarily disabled (plan upgrade needed) —
# see docs/SCOPE.md. No HUBSPOT_* vars are required to run the app.

# api.slack.com/apps -> your app -> Basic Information / OAuth & Permissions.
# Add ${APP_BASE_URL}/auth/slack/callback as a redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Filing scanner (docs/PRD-IT-INFRA-SCANNER.md) — all optional. The rest
# of the app runs fine without these; POST /filing-scanner/scan returns
# 503 until SEC_EDGAR_USER_AGENT and ANTHROPIC_API_KEY are both set.

# Required by SEC's fair-access policy to identify the requester, e.g.
# "InfrOS filing-scanner contact@infros.io" — see
# https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT=

# console.anthropic.com -> API keys. Used to classify filing text
# against the signal taxonomy in apps/api/src/filingScanner/taxonomy.ts.
ANTHROPIC_API_KEY=

# Apollo enrichment (company resolution + firmographic fit). Omit to
# run the scanner without company resolution.
APOLLO_API_KEY=

# Knock-ai (qualified-hit alerting). Omit to run the scanner without
# notifications — signals are still persisted for review either way.
KNOCK_API_KEY=
KNOCK_WORKFLOW_KEY=
KNOCK_RECIPIENT_IDS=

# apps/web
VITE_API_BASE_URL=http://localhost:3000
