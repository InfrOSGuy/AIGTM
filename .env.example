# Copy to .env and fill in real values. Never commit .env — it's
# git-ignored, and CI runs a secret scan on every push regardless.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://aigtm:aigtm@localhost:5432/aigtm

# AES-256-GCM key for encrypting stored OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Pre-shared secret you exchange once at /auth/login for a session
# cookie. Treat like a password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# (Web application). Add ${APP_BASE_URL}/auth/gmail/callback as an
# authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# HubSpot developer account -> App -> Auth. Add
# ${APP_BASE_URL}/auth/hubspot/callback as a redirect URL.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
# App -> Webhooks -> signing secret (used to verify inbound webhooks).
HUBSPOT_WEBHOOK_SIGNING_SECRET=

# api.slack.com/apps -> your app -> Basic Information / OAuth & Permissions.
# Add ${APP_BASE_URL}/auth/slack/callback as a redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# apps/web
VITE_API_BASE_URL=http://localhost:3000
