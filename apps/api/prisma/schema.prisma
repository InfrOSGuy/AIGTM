// AIGTM data model.
//
// Security note: IntegrationConnection never stores plaintext OAuth
// tokens. accessTokenEnc/refreshTokenEnc are opaque strings produced by
// src/crypto/tokenCipher.ts (AES-256-GCM). Application code must always
// go through that module — never write raw token bytes to these columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrationProvider {
  gmail
  hubspot
  slack
}

enum LeadStage {
  new
  enriching
  scored
  qualified
  disqualified
  outreach_drafted
  outreach_sent
  replied
}

enum OutreachStatus {
  drafted
  approved
  sent
  rejected
}

model Company {
  id               String   @id @default(cuid())
  domain           String   @unique
  name             String
  industry         String?
  employeeCount    Int?
  hubspotCompanyId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leads   Lead[]
  filings Filing[]
}

model Lead {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  email            String    @unique
  firstName        String?
  lastName         String?
  title            String?
  source           String
  stage            LeadStage @default(new)
  hubspotContactId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scores         LeadScore[]
  outreachDrafts OutreachDraft[]

  @@index([stage])
}

model IcpDefinition {
  id               String   @id @default(cuid())
  name             String
  rulesJson        Json
  dealBreakersJson Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scores LeadScore[]
}

model LeadScore {
  id              String        @id @default(cuid())
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id])
  icpDefinitionId String
  icpDefinition   IcpDefinition @relation(fields: [icpDefinitionId], references: [id])
  fitScore        Int
  intentScore     Int
  rationale       String
  createdAt       DateTime      @default(now())

  @@index([leadId])
}

// One row per connected provider. Single-tenant, so no orgId — if this
// ever becomes multi-tenant, add an orgId + unique(orgId, provider).
model IntegrationConnection {
  id              String              @id @default(cuid())
  provider        IntegrationProvider @unique
  accessTokenEnc  String
  refreshTokenEnc String?
  scopes          String[]
  expiresAt       DateTime?
  connectedAt     DateTime            @default(now())
  lastRefreshedAt DateTime?
  revokedAt       DateTime?
}

// Short-lived, single-use CSRF state for the OAuth authorization-code
// flow. Rows are deleted on use; a background sweep can purge expired
// rows. Prevents authorization-code injection / login CSRF.
model OAuthState {
  id           String              @id @default(cuid())
  state        String              @unique
  provider     IntegrationProvider
  codeVerifier String? // PKCE verifier, when the provider supports PKCE
  createdAt    DateTime            @default(now())
  expiresAt    DateTime
}

// Outreach is always drafted first; a human must explicitly approve
// before AIGTM is allowed to send anything through Gmail.
model OutreachDraft {
  id           String         @id @default(cuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id])
  subject      String
  bodyText     String
  gmailDraftId String?
  status       OutreachStatus @default(drafted)
  approvedBy   String?
  approvedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())

  @@index([leadId])
  @@index([status])
}

// Append-only trail for sensitive actions: integration connect/disconnect,
// outreach approval/send, ICP rule changes. Never update or delete rows
// from application code.
model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// --- Filing scanner (docs/PRD-IT-INFRA-SCANNER.md) ---
//
// A new lead *source*: scans SEC EDGAR filings (and, later, other
// filing-shaped text) for passages indicating a company is starting or
// managing an IT infrastructure project. This never writes a Lead
// directly — a Lead requires a real contact email, and this pipeline
// only resolves companies, not people (LinkedIn/Sales Navigator
// contact verification in the PRD is a manual, human step). Output
// here is a reviewable shortlist of scored FilingSignal rows.

enum SignalType {
  capex_new_infrastructure
  platform_replatforming
  new_it_leadership
  security_compliance_investment
  ma_it_integration
  explicit_budget_or_rfp
}

enum SignalStrength {
  strong
  weak
}

// One row per filing we've fetched, regardless of whether it yielded
// any signal. accessionNumber is SEC's own unique identifier for a
// filing, so re-scanning the same date range is naturally idempotent.
model Filing {
  id              String   @id @default(cuid())
  cik             String
  companyName     String
  form            String
  accessionNumber String   @unique
  filedAt         DateTime
  sourceUrl       String
  fetchedAt       DateTime @default(now())

  // Best-effort resolution via the enrichment waterfall (Apollo).
  // Null when the company couldn't be resolved to a domain yet —
  // the filing and its signals are still worth keeping for review.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  signals FilingSignal[]

  @@index([cik])
  @@index([filedAt])
}

model FilingSignal {
  id       String @id @default(cuid())
  filingId String
  filing   Filing @relation(fields: [filingId], references: [id])

  signalType        SignalType
  strength          SignalStrength
  quote             String
  confidence        Float
  extractedSystem   String?
  extractedVendor   String?
  extractedBudget   String?
  extractedTimeline String?
  score             Int

  // Manual precision-review loop (PRD §8/§9): the GTM user marks each
  // surfaced hit relevant/not, feeding future taxonomy/prompt tuning.
  reviewedRelevant Boolean?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([filingId])
  @@index([signalType])
  @@index([score])
}
